/*
 * SPDX-License-Identifier: Apache-2.0
 * Copyright (c) 2026 Leonardo Capossio - bard0 design
 *
 * App-side overlay for arty_a7_vex. Mirrors mbv32.overlay's emacZero/DMA
 * layout with two differences:
 *   - IRQ index order matches hardware/scripts/build_arty_a7_vex.py's
 *     xlconcat (uart=0, gpio=1, mm2s=2, s2mm=3, emaczero=4), NOT the mbv
 *     shell's numbering.
 *   - There is only one AXI bus root in the DTS (soc/simple-bus), so we
 *     add nodes directly to the base DTS's root (no &axi label needed).
 *
 * Address map (verified against build_arty_a7_vex.py):
 *   emacZero        @ 0x44A00000
 *   AXI DMA         @ 0x41E00000
 *   axis_rx_stats   @ 0x41F00000
 *   AXI INTC        @ 0x41200000
 *   UARTLite        @ 0x40600000
 *   DDR             @ 0x90000000 (240 MiB Zephyr + 16 MiB uncached DMA window
 *                     at 0x9F000000: 64 KiB SG descriptors, frame buffers,
 *                     and the 8 KiB host page at 0x9FFFE000)
 */

/ {
	/* Uncached (outside the CPU D-cache aperture) home for the AXI DMA
	 * scatter-gather descriptor rings.
	 */
	dma_desc: memory@9f000000 {
		compatible = "zephyr,memory-region";
		reg = <0x9f000000 0x10000>;
		zephyr,memory-region = "DMA_DESC";
	};

	/* emacZero RX and TX packet buffers, in the same uncached window. It
	 * stops where emz_hostio starts.
	 */
	emz_bufs: memory@9f010000 {
		compatible = "zephyr,memory-region";
		reg = <0x9f010000 0xfee000>;
		zephyr,memory-region = "EMZ_BUFFERS";
	};

	/* Host-visible page at fixed addresses the host tools reach over
	 * JTAG-AXI: the provisioning mailbox, then the app's perf stats.
	 */
	emz_hostio: memory@9fffe000 {
		compatible = "zephyr,memory-region";
		reg = <0x9fffe000 0x2000>;
		zephyr,memory-region = "EMZ_HOSTIO";
	};

	/* The MII PHY is not managed by software; the link is fixed at
	 * 100 Mbit/s full duplex. The parent node only supplies the address
	 * cells for the PHY's reg.
	 */
	emz_phy_bus {
		#address-cells = <1>;
		#size-cells = <0>;

		emz_phy: ethernet-phy@0 {
			compatible = "ethernet-phy";
			reg = <0>;
			fixed-link = "100BASE-T Full-Duplex";
		};
	};

	aliases {
		ethernet0 = &emaczero0;
	};

	soc {
		emaczero0: ethernet@44a00000 {
			compatible = "bard0,emaczero";
			status = "okay";
			reg = <0x44a00000 0x100>;
			interrupt-parent = <&intc0>;
			interrupts = <4 2>;
			axistream-connected = <&axi_dma0>;
			local-mac-address = [02 00 00 00 00 01];
			phy-connection-type = "mii";
			phy-handle = <&emz_phy>;
			memory-region = <&emz_bufs>;
		};

		axi_dma0: dma@41e00000 {
			compatible = "xlnx,axi-dma-1.00.a";
			status = "okay";
			reg = <0x41e00000 0x10000>;
			interrupt-parent = <&intc0>;
			interrupts = <2 2 3 2>;
			interrupt-names = "mm2s_introut", "s2mm_introut";
			#dma-cells = <0>;
			dma-channels = <2>;
			xlnx,addrwidth = <32>;
			memory-region = <&dma_desc>;
		};
	};
};
