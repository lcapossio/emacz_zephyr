+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Leonardo Capossio - bard0 design
+
+package vexriscv.plugin
+
+import vexriscv.{VexRiscv, _}
+
+// bard0: decode RISC-V FENCE (funct3=000, incl. fence.tso and pause) as a
+// no-op. This in-order core already retires memory operations in program
+// order, so treating FENCE as a NOP keeps today's ordering while making the
+// instruction legal: Zephyr's builtin barriers emit `fence` and would
+// otherwise trap. Unlike DummyFencePlugin this leaves FENCE.I undecoded, so
+// it still traps as illegal instead of silently skipping an I$ flush.
+class FenceNopPlugin extends Plugin[VexRiscv]{
+
+  override def setup(pipeline: VexRiscv): Unit = {
+    import Riscv._
+
+    val decoderService = pipeline.service(classOf[DecoderService])
+    decoderService.add(FENCE, Nil)
+  }
+
+  override def build(pipeline: VexRiscv): Unit = {}
+}
