DT_CHOSEN_Z_CONSOLE := zephyr,console

menu "emacz Zephyr app"

config EMACZ_APP_RAW_UART
	bool "emacz app raw UART status output"
	depends on SERIAL && $(dt_chosen_enabled,$(DT_CHOSEN_Z_CONSOLE))
	default y
	help
	  Enable the bring-up application's status prints, polled out on the
	  console UART.
	  Disable this for performance tests that must rule out blocking UART
	  output independently from Zephyr's console and logging settings.

config EMACZ_APP_PAYLOAD_BUF_OFFSET
	int "Byte offset of the UDP sink and TX benchmark buffers"
	range 0 3
	default 0
	help
	  Start the buffers the UDP sink receives into and the TX benchmark
	  sends from this many bytes past a word boundary. A UDP payload
	  starts 42 bytes into its frame, 2 bytes off a word boundary, and
	  the minimal libc memcpy copies word by word only when source and
	  destination share their alignment: 2 lets the socket copies run on
	  words instead of bytes.

config EMACZ_APP_THREAD_USAGE
	bool "Publish per-thread CPU time in the perf stats block"
	select THREAD_RUNTIME_STATS
	select THREAD_MONITOR
	select THREAD_NAME
	help
	  Run a high-priority thread that every 50 ms writes the cycles the
	  driver RX, UDP sink, control, main and system work queue threads and
	  the idle thread have used into the perf stats block, and refreshes
	  the MAC and network-stack counters there, which main otherwise does
	  once a second and not at all while a cooperative RX path holds the
	  CPU. For measurements: it adds 20 wakeups a second.

endmenu
