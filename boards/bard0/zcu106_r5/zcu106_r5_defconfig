# Loaded into DDR over JTAG by scripts/load_zynqmp_r5.py
CONFIG_XIP=n
CONFIG_ARM_MPU=y
CONFIG_ISR_STACK_SIZE=1024
CONFIG_MAIN_STACK_SIZE=2048
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_XLNX_PS=y
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
# The loader's core reset leaves the R5 caches off; with cache management
# the SoC's early init turns them on.
CONFIG_CACHE_MANAGEMENT=y
