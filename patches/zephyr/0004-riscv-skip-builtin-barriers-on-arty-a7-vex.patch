diff --git a/arch/Kconfig b/arch/Kconfig
index 4fca0c3c602..d9f9805c403 100644
--- a/arch/Kconfig
+++ b/arch/Kconfig
@@ -120,7 +120,13 @@ config RISCV
 	select USE_SWITCH
 	select SCHED_IPI_SUPPORTED if SMP
 	select ARCH_HAS_DIRECTED_IPIS
-	select BARRIER_OPERATIONS_BUILTIN
+	# bard0: VexRiscv-full's decoder rejects the RISC-V `fence` opcode
+	# (funct3=000/001, opcode=0001111) as illegal-instruction. Skip the
+	# builtin barriers for our shell; peripheral space (0x00000000-
+	# 0x7fffffff) is already uncached in our DBusCachedPlugin config so
+	# ordering across CPU-visible memory is provided by the in-order
+	# pipeline.
+	select BARRIER_OPERATIONS_BUILTIN if !SOC_ARTY_A7_VEX
 	select ARCH_HAS_THREAD_PRIV_STACK_SPACE_GET if USERSPACE
 	help
 	  RISCV architecture
