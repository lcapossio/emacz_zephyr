From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leonardo Capossio <capossio.leonardo@gmail.com>
Date: Sun, 1 Nov 2026 12:00:00 +0100
Subject: [PATCH] soc: xlnx: mbv32: data cache management with Zicbom

A MicroBlaze V configured with a data cache implements the Zicbom
cache-block operations. Wire them to the arch cache API so drivers
that keep DMA buffers in cached memory (CONFIG_CACHE_MANAGEMENT) can
clean and invalidate them: cbo.clean for a flush, cbo.inval for an
invalidate and cbo.flush for both. Each waits for outstanding memory
accesses, so a flush also orders the buffer writes before the
peripheral write that starts the DMA. Zicbom has no whole-cache
operation, so the *_all calls return -ENOTSUP.

The SoC selects CPU_HAS_DCACHE only when the devicetree CPU node
gives d-cache-line-size, the same property that sets
DCACHE_LINE_SIZE, so cores without a data cache are unaffected.

On an Arty A7 at 100 MHz (16 KiB write-through D-cache, 16-byte
lines) with the AXI DMA frame buffers moved into the cached aperture,
UDP socket receive rises from 19.6 to 28.2 Mbit/s and transmit from
15.7 to 18.0 Mbit/s (1472-byte payloads, 100 Mbit/s link, 5 s runs),
with no payload corruption under a varying-payload checksum test.

Signed-off-by: Leonardo Capossio <capossio.leonardo@gmail.com>
---
diff --git a/soc/xlnx/mbv32/CMakeLists.txt b/soc/xlnx/mbv32/CMakeLists.txt
index d53aa5fe7df..69daa06d249 100644
--- a/soc/xlnx/mbv32/CMakeLists.txt
+++ b/soc/xlnx/mbv32/CMakeLists.txt
@@ -9,6 +9,7 @@ zephyr_sources(
     ${ZEPHYR_BASE}/soc/common/riscv-privileged/vector.S
     soc.c
 )
+zephyr_sources_ifdef(CONFIG_ARCH_CACHE cache.c)
 
 zephyr_include_directories(.)
 
diff --git a/soc/xlnx/mbv32/Kconfig b/soc/xlnx/mbv32/Kconfig
index e1e2511ee01..4c426b46c88 100644
--- a/soc/xlnx/mbv32/Kconfig
+++ b/soc/xlnx/mbv32/Kconfig
@@ -8,6 +8,8 @@ config SOC_MBV32
 	select RISCV
 	select ATOMIC_OPERATIONS_C
 	select INCLUDE_RESET_VECTOR
+	# A D-cache is optional in the IP; the CPU node describes one
+	select CPU_HAS_DCACHE if $(dt_node_has_prop,/cpus/cpu@0,d-cache-line-size)
 	select CLOCK_CONTROL
 	select CLOCK_CONTROL_FIXED_RATE_CLOCK
 	select CONSOLE
diff --git a/soc/xlnx/mbv32/cache.c b/soc/xlnx/mbv32/cache.c
new file mode 100644
index 00000000000..7640318d3eb
--- /dev/null
+++ b/soc/xlnx/mbv32/cache.c
@@ -0,0 +1,82 @@
+/*
+ * Copyright (c) 2026 Leonardo Capossio - bard0 design
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * MicroBlaze V data cache maintenance with the Zicbom instructions, which
+ * the core implements whenever a cache is configured. Each operates on the
+ * cache block holding rs1 and waits for outstanding memory accesses to
+ * complete, so a clean also orders the cached port's writes before a later
+ * peripheral write that starts a DMA master. Zicbom has no whole-cache
+ * operation.
+ */
+
+#include <errno.h>
+#include <zephyr/arch/cache.h>
+#include <zephyr/sys/util.h>
+
+#define LINE_SIZE CONFIG_DCACHE_LINE_SIZE
+
+/* cbo.inval, cbo.clean, cbo.flush: MISC-MEM, funct3 010, imm 0, 1, 2 */
+#define CBO_INVAL 0
+#define CBO_CLEAN 1
+#define CBO_FLUSH 2
+
+#define CBO(op, addr) __asm__ volatile(".insn i 0x0f, 2, x0, %0, %1" : : "r"(addr), "i"(op) : "memory")
+
+#define RANGE_OP(op, addr, size)                                                                   \
+	do {                                                                                       \
+		uintptr_t line = ROUND_DOWN((uintptr_t)(addr), LINE_SIZE);                         \
+		uintptr_t end = (uintptr_t)(addr) + (size);                                        \
+                                                                                                   \
+		for (; line < end; line += LINE_SIZE) {                                            \
+			CBO(op, line);                                                             \
+		}                                                                                  \
+	} while (false)
+
+void arch_cache_init(void)
+{
+}
+
+void arch_dcache_enable(void)
+{
+}
+
+void arch_dcache_disable(void)
+{
+}
+
+int arch_dcache_flush_range(void *addr, size_t size)
+{
+	RANGE_OP(CBO_CLEAN, addr, size);
+	return 0;
+}
+
+int arch_dcache_invd_range(void *addr, size_t size)
+{
+	RANGE_OP(CBO_INVAL, addr, size);
+	return 0;
+}
+
+int arch_dcache_flush_and_invd_range(void *addr, size_t size)
+{
+	RANGE_OP(CBO_FLUSH, addr, size);
+	return 0;
+}
+
+int arch_dcache_flush_all(void)
+{
+	return -ENOTSUP;
+}
+
+int arch_dcache_invd_all(void)
+{
+	return -ENOTSUP;
+}
+
+int arch_dcache_flush_and_invd_all(void)
+{
+	return -ENOTSUP;
+}
