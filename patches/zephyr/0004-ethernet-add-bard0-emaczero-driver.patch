+# Copyright (c) 2026 Leonardo Capossio - bard0 design
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  bard0 emacZero Ethernet MAC.
+
+  emacZero is an open-source 10/100/1000 Ethernet MAC for FPGAs
+  (https://github.com/lcapossio/emacZero). Frames move through a Xilinx AXI
+  DMA connected over AXI-Stream: MM2S feeds the MAC's TX stream and S2MM
+  receives its RX stream.
+
+  Link state, speed and duplex come from the PHY referenced by phy-handle.
+  Use an ethernet-phy-fixed-link node when the PHY is not managed by
+  software.
+
+  Example:
+
+    eth_phy: ethernet-phy {
+      compatible = "ethernet-phy-fixed-link";
+      default-speeds = "100BASE Full-Duplex";
+    };
+
+    ethernet@44a00000 {
+      compatible = "bard0,emaczero";
+      reg = <0x44a00000 0x100>;
+      axistream-connected = <&axi_dma0>;
+      phy-handle = <&eth_phy>;
+      local-mac-address = [02 00 00 00 00 01];
+    };
+
+compatible: "bard0,emaczero"
+
+include: ethernet-controller.yaml
+
+properties:
+  reg:
+    required: true
+
+  phy-handle:
+    required: true
+
+  axistream-connected:
+    type: phandle
+    required: true
+    description: |
+      Xilinx AXI DMA ("xlnx,axi-dma-1.00.a" or "xlnx,eth-dma") whose MM2S
+      and S2MM streams are connected to this MAC.
+
+  memory-region:
+    type: phandle
+    description: |
+      Optional "zephyr,memory-region" node whose linker section holds the
+      RX and TX packet buffers. The DMA engine reads and writes them
+      directly, so on targets with a data cache, point this at an uncached
+      memory window or enable CONFIG_DMA_XILINX_AXI_DMA_MANUAL_CACHE_COHERENCY.
